{
  "name": "test-suggerimenti",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch src/server.ts\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node build/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.11"
  }
}
